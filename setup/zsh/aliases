#wrap command in faketime through ligolo
fakelig() {
  faketime "$(ntpdate -q 240.0.0.1 | cut -d " " -f 1,2)" "$@"
}



# Returns 0 if TCP port is already LISTENing, 1 otherwise
port_in_use () {
  local port="$1"

  if command -v ss >/dev/null 2>&1; then
    ss -H -ltn "sport = :$port" | grep -q .
    return $?
  elif command -v lsof >/dev/null 2>&1; then
    lsof -iTCP:"$port" -sTCP:LISTEN -Pn >/dev/null 2>&1
    return $?
  else
    echo "Need 'ss' (iproute2) or 'lsof' to check ports." >&2
    return 2
  fi
}

pyserv () {
  # usage: pyserv2 [port] [directory]
  local port="${1:-8000}"
  local dir="${2:-.}"

  # get tun0 ip for display / bind
  local tun0_ip
  tun0_ip="$(ip -4 addr show tun0 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -n 1)"

  # check if tun0 looks alive
  if [[ -z "$tun0_ip" ]]; then
    echo "tun0 looks down (no IPv4), canceling..." >&2
    return 1
  fi

  # validate port
  if ! [[ "$port" =~ ^[0-9]{1,5}$ ]] || (( port < 1 || port > 65535 )); then
    echo "Invalid port: $port" >&2
    return 2
  fi

  # validate directory (optional)
  if [[ ! -d "$dir" ]]; then
    echo "Directory not found: $dir" >&2
    return 3
  fi

  # check if port is already in use
  if port_in_use "$port"; then
    echo "Port $port is already in use." >&2
    return 4
  fi

  echo "HTTP server running @ http://$tun0_ip:$port (dir: $dir)"
  python3 -m http.server "$port" --bind "$tun0_ip" --directory "$dir"
}




