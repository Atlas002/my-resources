# Config file dedicated to the user's personal zshrc profile shared between all exegol containers.
# This file is sourced in /root/.zshrc file.
# Alternatively, the /opt/my-resources/setup/load_user_setup.sh file can be used to operate the change once (instead of sourcing a file for each zsh instance)
source /opt/my-resources/setup/zsh/aliases


resetws() {
    rm -rf /workspace/*
    mkdir -p /workspace/{outputs,downloads,uploads,tools}
    echo "[+] Workspace wiped and reset"
}

listen() {
    local PORT=""
    local USE_PWNCAT=false
    for arg in "$@"; do
    case "$arg" in
        --linux) USE_PWNCAT=true ;;
        *) PORT="$arg" ;;
    esac
    done
    if [[ -z "$PORT" ]]; then
    echo "Usage: listen <port> [--linux]"; return 1
    fi
    if $USE_PWNCAT; then
    echo "[+] Listening on 0.0.0.0:$PORT with pwncat"
    pwncat-vl -lp "$PORT" 0.0.0.0
    else
    echo "[+] Listening on 0.0.0.0:$PORT with netcat"
    nc -lvnp "$PORT"
    fi
}

# exegoltime hook
[[ -f /tmp/.exegoltime_offset ]] && eval "$(source /tmp/.exegoltime_offset 2>/dev/null && printf 'export LD_PRELOAD=/usr/lib/x86_64-linux-gnu/faketime/libfaketime.so.1\nexport FAKETIME=%s\nexport FAKETIME_NO_CACHE=1\nexport FAKETIME_DONT_FAKE_MONOTONIC=1' "${ET_OFFSET}")"
exegoltime() { source /opt/my-resources/bin/exegoltime "$@"; }
